services:
  db:
    image: mysql:{{ db_engine_version }}
    restart: unless-stopped
    env_file: .env
    volumes:
      - db_data:/var/lib/mysql
      - ./database.sql:/docker-entrypoint-initdb.d/10-backup.sql:ro
    networks: [site_internal]
    healthcheck:
      test: ["CMD-SHELL", "mysqladmin ping -h 127.0.0.1 -uroot -p$${MYSQL_ROOT_PASSWORD} --silent"]
      interval: 5s
      timeout: 5s
      retries: 60
      start_period: 20s
{% if http_server_name | lower == 'nginx' %}
  php:
    image: wordpress:{{ wp_version }}-php{{ php_version }}-fpm
    restart: unless-stopped
    env_file: .env
    volumes: ["./files:/var/www/html"]
    depends_on:
      db: { condition: service_healthy }
    networks: [site_internal]
  web:
    image: nginx:{{ http_server_version }}
    restart: unless-stopped
    volumes:
      - ./files:/var/www/html:ro
      - ./nginx.conf:/etc/nginx/conf.d/default.conf:ro
    depends_on: [php]
    networks:
      site_internal:
      proxy:
        aliases: [wp-local-{{ restore_slug }}-web]
{% else %}
  web:
    image: wordpress:{{ wp_version }}-php{{ php_version }}-apache
    restart: unless-stopped
    env_file: .env
    volumes: ["./files:/var/www/html"]
    depends_on:
      db: { condition: service_healthy }
    networks:
      site_internal:
      proxy:
        aliases: [wp-local-{{ restore_slug }}-web]
{% endif %}
  wpcli:
    image: wordpress:cli-php{{ php_version }}
    profiles: [tools]
    user: "33:33"
    environment: { HOME: /tmp }
    volumes: ["./files:/var/www/html"]
    working_dir: /var/www/html
    networks: [site_internal, cli_egress]
volumes:
  db_data:
networks:
  site_internal:
    internal: true
  cli_egress:
  proxy:
    external: true
    name: {{ proxy_network_name }}
